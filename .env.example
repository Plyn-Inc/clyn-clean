# ─── 운영 DB: Supabase PostgreSQL ────────────────────────────────────────────
# Vercel에서는 Supabase Dashboard → Connect에서 제공하는 Transaction pooler URI를
# 그대로 DATABASE_URL에 등록하세요. 비밀번호/실제 URI는 Git에 커밋하지 않습니다.
# 예: postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# 로컬/회귀테스트에서만 SQLite를 사용하려면 DATABASE_PATH를 설정합니다.
# DATABASE_URL과 DATABASE_PATH가 둘 다 있으면 DATABASE_URL이 우선합니다.
# DATABASE_PATH=.local-data/cleaning-reservation.db

# ─── 관리자 초기 계정 ─────────────────────────────────────────────────────────
# 최초 실행 시 admins 테이블이 비어 있으면 아래 값으로 관리자 계정을 생성합니다.
# 최초 로그인 후 반드시 비밀번호를 변경하세요.
ADMIN_DEFAULT_USERNAME=TODO
ADMIN_DEFAULT_PASSWORD=TODO_10자이상_특수문자포함
ADMIN_DEFAULT_NAME=관리자

# ─── JWT 서명 키 ──────────────────────────────────────────────────────────────
# 최소 32자 이상의 무작위 문자열을 사용하세요. 예: openssl rand -hex 32
JWT_SECRET=TODO_32자이상_무작위문자열

# ─── 사이트 공개 URL ──────────────────────────────────────────────────────────
# Vercel 임시 배포 테스트 중에는 https://<project>.vercel.app
# 실제 도메인 연결 후에는 https://실제도메인 으로 변경합니다.
SITE_URL=https://your-project.vercel.app

NODE_ENV=production
